{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collie-mobility-transit-webpage-app",
  "main": "server/index.ts",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collie-mobility-transit-db",
      "database_id": "local-db-id"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FLEET_KV",
      "id": "collie-fleet-kv-id"
    }
  ]
}
